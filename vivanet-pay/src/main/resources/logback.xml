<?xml version="1.0" encoding="UTF-8"?>
<!--
  Logs rotativos con niveles y redacción automática de datos sensibles (RNF-012, RF-018, IDD §10.3).
  Directorio: propiedad de sistema vivanet.log.dir (la fija AppConfig/HeadlessMain antes de iniciar logs);
  por defecto ${user.home}/.vivanetpay/logs.
  %rmsg  = mensaje redactado; %rex = excepción redactada; %X{cid} = correlationId.
-->
<configuration scan="false">
  <conversionRule conversionWord="rmsg" class="com.vivanetpay.observability.RedactingMessageConverter"/>
  <conversionRule conversionWord="rex" class="com.vivanetpay.observability.RedactingThrowableConverter"/>

  <property name="LOG_DIR" value="${vivanet.log.dir:-${user.home}/.vivanetpay/logs}"/>
  <property name="LOG_LEVEL" value="${vivanet.log.level:-INFO}"/>
  <property name="PATTERN" value="%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %-5level [%thread] [cid=%X{cid:-}] %logger{36} - %rmsg%n%rex"/>

  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <charset>UTF-8</charset>
      <pattern>${PATTERN}</pattern>
    </encoder>
  </appender>

  <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>${LOG_DIR}/vivanetpay.log</file>
    <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
      <fileNamePattern>${LOG_DIR}/vivanetpay.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
      <maxFileSize>10MB</maxFileSize>
      <!-- Retención provisional (DP-10 pendiente) -->
      <maxHistory>30</maxHistory>
      <totalSizeCap>300MB</totalSizeCap>
    </rollingPolicy>
    <encoder>
      <charset>UTF-8</charset>
      <pattern>${PATTERN}</pattern>
    </encoder>
  </appender>

  <!-- Librerías ruidosas -->
  <logger name="com.google" level="WARN"/>
  <logger name="org.sqlite" level="WARN"/>

  <root level="${LOG_LEVEL}">
    <appender-ref ref="CONSOLE"/>
    <appender-ref ref="FILE"/>
  </root>
</configuration>
